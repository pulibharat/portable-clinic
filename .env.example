# ============================================================================
# Portable Clinic — Environment Configuration Template
# Copy to .env and adjust variables as needed
# ============================================================================

# Video Source (0 for USB Webcam or RTSP Stream URL)
VIDEO_SOURCE=0
RTSP_URL=rtsp://username:password@192.168.1.100:554/stream
RTSP_TIMEOUT_MS=5000
STREAM_STALE_SEC=3.0

# Optional shared PostgreSQL database. Leave empty to use local data/clinic.db.
# DATABASE_URL=postgresql://user:password@host/database

# Registered Doctor Names (comma-separated, case-insensitive)
# Enrolled persons matching these names trigger the Doctor Attendance Tracker
DOCTOR_NAMES=bharat,doctor,puli

# Debounce & Grace Periods (in seconds)
# Time without camera detection before marking Doctor or Visitor as EXITED
DOCTOR_EXIT_GRACE_SEC=12.0
VISITOR_EXIT_GRACE_SEC=8.0

# ArcFace & SCRFD Detection Settings
DET_WIDTH=384
DET_HEIGHT=384
DET_THRESH=0.35
MIN_FACE_PX=40

# Matching Thresholds
SIMILARITY_THRESHOLD=0.38
MATCH_MARGIN=0.05
SMOOTH_FRAMES=5

# Tracking Parameters
TRACK_IOU_THRESH=0.25
MAX_MISSES=20
CENTROID_MATCH_FACTOR=0.9
RELINK_GRACE_FRAMES=45
RELINK_MAX_DIST_FACTOR=1.75

# Display & Resolution
CAM_WIDTH=1280
CAM_HEIGHT=720
DISPLAY_MAX_WIDTH=1280
INFER_MAX_WIDTH=640

# Server Settings
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
WORKERS=1
